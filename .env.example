# APEX RAG & Telegram Bot Configuration
# Copy this file to .env and fill in your values

# Telegram Bot Credentials
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram numeric user ID (get from @userinfobot)
# Multiple IDs can be separated by commas (e.g. 12345678,98765432)
TELEGRAM_ALLOWED_USERS=

# Whether to automatically run full hierarchical clustering immediately on PDF upload
# false = Fast ingestion into ChromaDB, run clustering on-demand with /cluster_run
# true = Automatically cluster immediately upon upload
TELEGRAM_AUTO_CLUSTER=false

# Ollama Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:1b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ChromaDB Storage
CHROMA_PATH=./hierarchical_chroma_db
